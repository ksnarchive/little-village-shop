[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/checkout_menu.gd" id="1"]

[node name="CheckoutMenu" type="VBoxContainer"]
visible = false
theme_override_constants/separation = 10
script = ExtResource("1")

[node name="Header" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"OrderHeader"

[node name="Heading" type="VBoxContainer" parent="Header"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Header/Heading"]
layout_mode = 2
text = "Village checkout"
theme_override_font_sizes/font_size = 21

[node name="SaleBalance" type="Label" parent="Header/Heading"]
unique_name_in_owner = true
layout_mode = 2

[node name="SaleTotals" type="Label" parent="Header/Heading"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13

[node name="CustomerName" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="ProductCard" type="PanelContainer" parent="."]
layout_mode = 2
theme_type_variation = &"OrderRow"

[node name="Row" type="HBoxContainer" parent="ProductCard"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SaleIcon" type="TextureRect" parent="ProductCard/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="SaleProduct" type="Label" parent="ProductCard/Row"]
unique_name_in_owner = true
layout_mode = 2

[node name="SaleStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13

[node name="Serve" type="Button" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_type_variation = &"OrderButton"
text = "Обслужить"

[node name="SaleMessage" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13

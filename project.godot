; Engine configuration file.
; Little Village Shop — Godot 4.x

config_version=5

[application]
config/name="Little Village Shop"
run/main_scene="res://scenes/start.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A cozy pixel-art shop simulator"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/mode.web="viewport"
window/stretch/scale_mode="integer"

[input]

interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73)]
}

[rendering]
2d/snap/snap_2d_transforms_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.835, 0.804, 0.733, 1)
